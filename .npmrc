# @bifrost-compute/bifrost-client comes from GitHub Packages (source of truth =
# bifrost-api's openapi.json). GHCR npm needs a token even for public packages:
#   local:  export NODE_AUTH_TOKEN=$(gh auth token)   # classic PAT w/ read:packages
#   CI:     NODE_AUTH_TOKEN=${{ secrets.GITHUB_TOKEN }}
@bifrost-compute:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
